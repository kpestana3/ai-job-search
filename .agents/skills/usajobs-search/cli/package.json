{
  "name": "usajobs-cli",
  "version": "1.0.0",
  "description": "CLI for the official USAJOBS Search API (data.usajobs.gov) — federal government job announcements. Requires a free API key.",
  "type": "module",
  "main": "src/cli.ts",
