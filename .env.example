# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Bun auto-loads .env from the current working directory, so this works as long as
# the usajobs-search CLI is invoked from the repo root (its documented usage).

# USAJOBS Search API (.agents/skills/usajobs-search/) — free key, no approval process.
# Register at developer.usajobs.gov (see .agents/skills/usajobs-search/README.md for
# the current signup path). USAJOBS_USER_AGENT should match the email you registered with.
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
